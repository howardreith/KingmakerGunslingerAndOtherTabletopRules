{
  "name": "spear-bootstrap-simulated",
  "description": "Spear startup repair (PR #195), simulated conditions on the candidate with the product alone. Every condition is a controlled, test-only stand-in applied by the harness before the product initializes; none is claimed to be what the reporter's installation did. (1) Simulated donor mutation: the live native Longspear gets a 15 ft serialized reach and the Polearms fighter group, values the v0.0.188-v0.0.192 clone validation rejects; the candidate must still initialize, register the spear with its intended profile, leave the mutated donor and an unrelated weapon type exactly as they were before it ran, and keep native and battered pricing. (2) Invalid owned profile: the owned clone's fighter group is corrupted while the product validates it and a harness identity postfix sits on the FighterGroup getter; initialization must fail with the new diagnostic naming the predicate, expected, actual and donor values and the patch owner, and afterwards ordinary weapon prices and tooltips must stay native with exactly one unavailable-state warning. (3) Shared getter patch: a harness postfix on the shared BlueprintWeaponType.AttackRange getter adds 1 ft for the Longspear family (a reach-extension stand-in); the candidate must initialize and report that patch once.",
  "ownerMods": [],
  "fixtureSaves": [
    "KMCS_AFTER_NORMAL_012_MODONLY.zks"
  ],
  "launches": [
    {
      "label": "simulated-donor-mutation",
      "gameArguments": [
        "locale=enGB"
      ],
      "conditions": {
        "mutateNativeLongspear": "m_AttackRange=15;m_FighterGroup=Polearms",
        "captureWeaponTypes": "fa2dd17cbde7d3f4aa918d467c30516e,36d0551b8a28587438a47fcbbf53c083"
      },
      "expectLog": {
        "present": [
          "[blueprints][initialize.complete]",
          "[elven-branched-spear][foundation.ready]"
        ],
        "absent": [
          "[initialize.failed]",
          "Elven Branched Spear type profile is invalid",
          "profile.external-getter-patch",
          "Native Longspear donor"
        ]
      },
      "harness": {
        "save": "KMCS_AFTER_NORMAL_012_MODONLY.zks",
        "steps": [
          { "op": "kmgInitialization", "label": "mutated-donor", "expect": "completed", "continueOnFailure": true },
          { "op": "kmgWeaponTypeProfile", "label": "mutated-donor", "match": "owned", "type": "fa2dd17cbde7d3f4aa918d467c30516e,36d0551b8a28587438a47fcbbf53c083", "expect": "fighter-group,attack-range", "continueOnFailure": true },
          {
            "op": "kmgItemPricing",
            "label": "mutated-donor",
            "type": "f28f6031c2908d84d945865a80f67177,6fd0a849531617844b195f452661b2cd,19a5092244dcf99478dcd73c974828b1",
            "expect": "native",
            "match": "battered",
            "invariants": { "repeat": "20" },
            "continueOnFailure": true
          }
        ]
      }
    },
    {
      "label": "invalid-owned-profile",
      "gameArguments": [
        "locale=enGB"
      ],
      "conditions": {
        "corruptOwnedSpearProfile": "m_FighterGroup=Polearms",
        "patchWeaponTypeGetters": "FighterGroup",
        "captureWeaponTypes": "fa2dd17cbde7d3f4aa918d467c30516e,36d0551b8a28587438a47fcbbf53c083"
      },
      "expectLog": {
        "present": [
          "[blueprints][initialize.failed]",
          "Elven Branched Spear type profile is invalid: 1 of 15 checks failed.",
          "fighter-group [owned-field]: expected=Spears actual=Polearms donor=Spears",
          "getterPatches=KmgLoaderCompatHarness"
        ],
        "once": [
          "battered-origin.inspection-unavailable"
        ],
        "absent": [
          "[blueprints][initialize.complete]",
          "The battered origin token blueprint is unavailable"
        ]
      },
      "harness": {
        "save": "KMCS_AFTER_NORMAL_012_MODONLY.zks",
        "steps": [
          { "op": "kmgInitialization", "label": "invalid-owned", "expect": "failed", "match": "Elven Branched Spear type profile is invalid: 1 of 15 checks failed.", "continueOnFailure": true },
          { "op": "kmgWeaponTypeProfile", "label": "invalid-owned", "match": "absent", "type": "fa2dd17cbde7d3f4aa918d467c30516e,36d0551b8a28587438a47fcbbf53c083", "expect": "none", "continueOnFailure": true },
          {
            "op": "kmgItemPricing",
            "label": "failed-startup",
            "type": "f28f6031c2908d84d945865a80f67177,6fd0a849531617844b195f452661b2cd,6efea466862f014469cec6c3f2b85cb7,19a5092244dcf99478dcd73c974828b1",
            "expect": "native",
            "invariants": { "repeat": "25" },
            "continueOnFailure": true
          },
          { "op": "kmgSorcererSummon", "label": "failed-startup-native-menu", "expect": "", "timeoutSeconds": 180, "continueOnFailure": true }
        ]
      }
    },
    {
      "label": "external-getter-patch",
      "gameArguments": [
        "locale=enGB"
      ],
      "conditions": {
        "externalAttackRangePatch": "true"
      },
      "expectLog": {
        "present": [
          "[blueprints][initialize.complete]",
          "attack-range [external-getter-patch]: expected=10ft actual=10ft",
          "getter expected=6ft actual=7ft donor=7ft"
        ],
        "once": [
          "[elven-branched-spear][profile.external-getter-patch]"
        ],
        "absent": [
          "[initialize.failed]",
          "Elven Branched Spear type profile is invalid"
        ]
      },
      "harness": {
        "steps": [
          { "op": "kmgInitialization", "label": "external-patch", "expect": "completed", "continueOnFailure": true },
          { "op": "kmgWeaponTypeProfile", "label": "external-patch", "match": "owned", "continueOnFailure": true }
        ]
      }
    }
  ]
}
