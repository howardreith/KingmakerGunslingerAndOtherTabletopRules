      },
      "harness": {
        "steps": [
          { "op": "kmgInitialization", "label": "owned-throws", "expect": "failed", "match": "2 of 17 checks failed", "continueOnFailure": true },
          { "op": "kmgWeaponTypeProfile", "label": "owned-throws", "match": "absent", "invariants": { "getterThrowsAtLeast": "1", "ownedValidations": "3", "corruptionsApplied": "1" }, "continueOnFailure": true },
          { "op": "kmgSpearSelectorState", "label": "owned-throws", "expect": "restored", "continueOnFailure": true }
