{
  "name": "summoning-publication-boundary",
  "description": "INT-01. The Expanded Summoning publication check with Races Unleashed, the provider of the Spider Summoner rows, as the only other mod: the product's own feature-module observation with the module on, a harness listing of every entry under the eighteen canonical summon parents, the module switched off through the loader panel, the listing again in a fresh process, and the product's observation with the module off. The harness listing reads the loaded library and does not use the product, so it describes a published package the same way as a candidate. This is not the eleven-mod installation of the original report.",
  "ownerMods": [
    "RacesUnleashed"
  ],
  "fixtureSaves": [],
  "launches": [
    {
      "label": "publication-module-on",
      "product": {
        "scenario": "observe-feature-module-settings",
        "parameters": {
          "gunslinger": true,
          "acadamaeGraduate": true,
          "shieldOther": true,
          "expandedSummoning": true,
          "elvenBranchedSpears": true,
          "easternWeapons": true,
          "brownFurTransmuter": true,
          "urbanBarbarian": true,
          "bodyguardFeats": true,
          "protectionFromAlignmentControlImmunity": true,
          "elementalRaces": true,
          "teleportationSpells": true,
          "magicCircleSpells": true
        },
        "timeoutSeconds": 600
      }
    },
    {
      "label": "census-on-then-disable",
      "harness": {
        "steps": [
          {
            "op": "expectMods",
            "match": "KingmakerGunslinger,KmgLoaderCompatHarness,RacesUnleashed",
            "expect": "CallOfTheWild,TweakOrTreat"
          },
          {
            "op": "kmgModules",
            "label": "initial",
            "match": ""
          },
          {
            "op": "kmgVariantCensus",
