{
  "name": "gunslinger-grit-ui-recipients",
  "description": "Regression for the missing Gunslinger class report against v0.0.190 (a NullReferenceException in Kingmaker's ability description getter, reached from the shared grit UI pass). The same launches FAIL on the published v0.0.190 package and PASS on a repaired candidate. They cover: on a stock game, exactly the audited abilities carry the shared grit indicator or keep their own grit resource logic, the pass reads no ability description, a second application changes nothing and malformed recipients are refused by name and GUID; initialization completes and the Gunslinger is published once when unassigned text resolves to null and when it resolves blank; under the null condition the class screen lists the Gunslinger and lets it be selected, and native creation commits one; an unrelated ability whose description getter throws during the pass is left alone; and an unrelated ability whose description says \"spend grit\" does not become a recipient. The expected ability identities are listed here by GUID and are not read from the product. The conditions are controlled stand-ins applied by the test-only harness. They do not reproduce any reporter's translation or mod set.",
  "ownerMods": [],
  "fixtureSaves": [],
  "launches": [
    {
      "label": "stock-recipients",
      "gameArguments": [
        "locale=enGB"
      ],
      "conditions": {
        "observeGritUiPass": "true"
      },
      "expectLog": {
        "present": [
          "[blueprints][initialize.complete]",
          "[grit][ui.shared-resource-ready]"
        ],
        "absent": [
          "[initialize.root-cause]",
          "[initialize.failed]",
          "rollback-failed]",
          "[rollback.incomplete]"
        ]
      },
      "harness": {
