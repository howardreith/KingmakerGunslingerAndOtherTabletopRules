  "findings": {
    "disposeMeaning": "ItemEntity.Dispose() only disposes the item enchantment collection. It is not the collection/equipment removal API.",
    "repairSearch": "No type or method name for Repair, MakeWhole, Make Whole, or Mending was present. ItemRestoreValue restores missing blueprint counts by adding new items and is not item-condition repair.",
    "replacementIdentity": "ItemsCollection.Add(BlueprintItem) and ItemSwitch.RunAction create a new ItemEntity through ItemsEntityFactory.CreateEntity. Replacement does not preserve exact runtime item identity.",
    "safeDetachmentContract": "Call ItemEntity.Collection.Remove(item). Remove delegates to count-aware removal, Extract clears Collection and equipped HoldingSlot through ItemSlot.RemoveItem(true), updates slot index, and raises collection removal bookkeeping.",
    "sprint27Decision": "Retain the exact firearm as empty/Wrecked and qualify a same-item token transition to empty/Broken. Do not automatically remove or replace the item."
  },
