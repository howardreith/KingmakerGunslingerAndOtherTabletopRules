+namespace KingmakerGunslinger.Firing
+{
+    /// <summary>
+    /// Pure outcome of beginning one firearm attack roll.
+    /// </summary>
+    internal enum FirearmDischargeStatus
+    {
+        Fired = 1,
+        Empty = 2,
+        Wrecked = 3
+    }
+}
