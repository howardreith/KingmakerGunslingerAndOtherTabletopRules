{
  "$comment": "Generic headless-developer permission base. {helper}, {enrollment} and {transcript_dir} are filled at enrollment; project configs add repository-specific allow/deny rules.",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit(./**)",
      "Write(./**)",
      "TodoWrite",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit -m *)",
      "Bash(git commit -F *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",
      "Bash(git grep *)",
      "Bash(git restore --staged *)",
      "Bash(git merge-base *)",
      "Bash(git ls-remote *)",
      "Bash(git fetch origin *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(grep *)",
      "Bash(sha256sum *)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(git add *)",
      "PowerShell(git commit -m *)",
      "PowerShell(git commit -F *)",
      "PowerShell(git rev-parse *)",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(Get-Content *)",
      "PowerShell(Select-String *)",
      "PowerShell(Get-FileHash *)",
      "PowerShell(Test-Path *)",
      "Bash(python {helper} push --enrollment {enrollment})",
      "PowerShell(python {helper} push --enrollment {enrollment})"
    ],
    "deny": [
      "Bash(git push*)",
      "Bash(gh *)",
      "Bash(git reset*)",
      "Bash(git clean*)",
      "Bash(git rebase*)",
      "Bash(git merge *)",
      "Bash(git tag*)",
      "Bash(git stash*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git restore .*)",
      "Bash(git worktree*)",
      "Bash(git branch*)",
      "Bash(git config*)",
      "Bash(git commit*--amend*)",
      "Bash(git commit*--no-verify*)",
      "Bash(rm -rf*)",
      "Bash(curl *)",
      "Bash(wget *)",
      "PowerShell(git push*)",
      "PowerShell(gh *)",
      "PowerShell(git reset*)",
      "PowerShell(git clean*)",
      "PowerShell(git commit*--amend*)",
      "PowerShell(git commit*--no-verify*)",
      "PowerShell(Remove-Item * -Recurse*)",
      "PowerShell(Invoke-WebRequest*)",
      "Bash(python tools/agent_review*)",
      "PowerShell(python tools/agent_review*)",
      "Edit(./tools/agent_review/**)",
      "Write(./tools/agent_review/**)",
      "Edit(./{transcript_dir}/**)",
      "Write(./{transcript_dir}/**)",
      "Edit(./.claude/**)",
      "Write(./.claude/**)",
      "Edit(./AGENTS.md)",
      "Write(./AGENTS.md)",
      "Edit(./CLAUDE.md)",
      "Write(./CLAUDE.md)",
      "Bash(python {helper} run*)",
      "PowerShell(python {helper} run*)",
      "Bash(python {helper} resume*)",
      "PowerShell(python {helper} resume*)",
      "Bash(python {helper} review*)",
      "PowerShell(python {helper} review*)",
      "Bash(python {helper} finalize*)",
      "PowerShell(python {helper} finalize*)",
      "Bash(python {helper} archive*)",
      "PowerShell(python {helper} archive*)",
      "Bash(python {helper} activate*)",
      "PowerShell(python {helper} activate*)",
      "Bash(python {helper} install*)",
      "PowerShell(python {helper} install*)",
      "Bash(python {helper} enroll*)",
      "PowerShell(python {helper} enroll*)",
      "Bash(python {helper} stop*)",
      "PowerShell(python {helper} stop*)",
      "Bash(python {helper} init-project*)",
      "PowerShell(python {helper} init-project*)",
      "Bash(python {helper} preflight*)",
      "PowerShell(python {helper} preflight*)"
    ]
  }
}
