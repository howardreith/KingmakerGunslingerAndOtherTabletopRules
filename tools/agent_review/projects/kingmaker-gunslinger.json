{
  "schema_version": "agent-review.project.v1",
  "project_id": "kmg",
  "repository": "howardreith/KingmakerGunslingerAndOtherTabletopRules",
  "allowed_remote_urls": [
    "https://github.com/howardreith/KingmakerGunslingerAndOtherTabletopRules.git",
    "git@github.com:howardreith/KingmakerGunslingerAndOtherTabletopRules.git"
  ],
  "default_target_branch": "master",
  "branch_pattern": "^codex/[a-z0-9][a-z0-9._/-]*$",
  "expected_actor": "howardreith",
  "push_command": [
    "powershell.exe",
    "-NoProfile",
    "-ExecutionPolicy",
    "Bypass",
    "-File",
    "C:/Dev/KingmakerGunslingerLab/codex-policy/Push-KingmakerGunslinger.ps1",
    "-RepositoryRoot",
    "{repo_root}"
  ],
  "transcript_dir": "docs/agent-reviews",
  "state_root": "C:/Dev/KingmakerGunslingerLab/agent-review-state",
  "instructions": [
    "AGENTS.md",
    "docs/VALIDATION-POLICY.md",
    "docs/AGENT-REVIEW-WORKFLOW.md"
  ],
  "developer": {
    "executable": "%USERPROFILE%/.local/bin/claude.exe",
    "config_dir": "%USERPROFILE%/.claude-personal",
    "model": "opus",
    "effort": "high",
    "allowed_model_pattern": "^claude-opus-",
    "soft_deadline_minutes": 480,
    "grace_minutes": 60,
    "permissions": {
      "allow": [
        "Bash(dotnet build *)",
        "Bash(dotnet test *)",
        "Bash(python -m unittest *)",
        "Bash(python tools/run_portable_domain_tests.py*)",
        "Bash(python tools/run_exact_net47_domain_tests.py*)",
        "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File C:/Dev/KingmakerGunslingerLab/codex-policy/Push-KingmakerGunslinger.ps1*)",
        "Bash(pwsh -NoProfile -File scripts/Invoke-KmgGate.ps1 *)",
        "Bash(powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/Invoke-KmgGate.ps1 *)",
        "PowerShell(dotnet build *)",
        "PowerShell(dotnet test *)",
        "PowerShell(python -m unittest *)",
        "PowerShell(python tools/run_portable_domain_tests.py*)",
        "PowerShell(python tools/run_exact_net47_domain_tests.py*)",
        "PowerShell(.\\scripts\\Invoke-KmgGate.ps1 *)",
        "PowerShell(.\\scripts\\Invoke-KingmakerRuntimeTest.ps1 *)",
        "PowerShell(.\\scripts\\Complete-KingmakerRuntimeLease.ps1 *)",
        "PowerShell(powershell.exe -NoProfile -ExecutionPolicy Bypass -File C:/Dev/KingmakerGunslingerLab/codex-policy/Push-KingmakerGunslinger.ps1*)"
      ],
      "deny": [
        "PowerShell(.\\scripts\\Deploy-Local.ps1*)",
        "PowerShell(.\\scripts\\Publish-*)",
        "PowerShell(.\\scripts\\Restore-Live-Mod.ps1*)",
        "PowerShell(.\\scripts\\Backup-Live-Mod.ps1*)",
        "PowerShell(.\\scripts\\Launch-Kingmaker.ps1*)",
        "Edit(./docs/VALIDATION-POLICY.md)",
        "Write(./docs/VALIDATION-POLICY.md)",
        "Edit(./GamePath.props)",
        "Write(./GamePath.props)"
      ]
    }
  },
  "reviewer": {
    "executable": "codex",
    "codex_home": "~/.codex",
    "model": "gpt-6.2-astra",
    "effort": "high",
    "timeout_minutes": 60,
    "extra_config": [
      "windows.sandbox=\"elevated\""
    ],
    "disabled_features": [
      "multi_agent",
      "apps",
      "plugins",
      "image_generation",
      "computer_use",
      "browser_use",
      "in_app_browser",
      "hooks",
      "memories"
    ]
  },
  "limits": {
    "max_review_rounds_per_checkpoint": 5,
    "max_review_attempts_per_round": 3,
    "max_developer_invocations": 30,
    "no_progress_rounds": 3,
    "publication_attempts": 4,
    "retry_backoff_seconds": [
      30,
      120
    ]
  },
  "runtime_lock_paths": [
    "C:/Dev/KingmakerGunslingerLab/compatibility-state/compatibility.lock"
  ]
}
