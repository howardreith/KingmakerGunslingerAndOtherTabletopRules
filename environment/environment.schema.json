{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Kingmaker Gunslinger development environment fingerprint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capturedAtUtc",
    "game",
    "host",
    "assemblies",
    "enabledMods"
  ],
  "properties": {
    "capturedAtUtc": {
      "type": "string"
    },
    "game": {
      "type": "object"
    },
    "host": {
      "type": "object"
    },
    "assemblies": {
      "type": "array"
    },
    "enabledMods": {
      "type": "array"
    }
  }
}
